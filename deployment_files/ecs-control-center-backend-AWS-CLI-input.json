{
    "family": "ecs-control-center-backend",
    "containerDefinitions": [
        {
            "cpu": 1024,
            "environment": [
                {
                    "name": "HISTORY_TABLE_NAME",
                    "value": "${HISTORY_TABLE_NAME}"
                },
                {
                    "name": "HISTORY_AWS_REGION",
                    "value": "${HISTORY_AWS_REGION}"
                },
                {
                    "name": "DYNATRACE_ENV_URL",
                    "value": "${DYNATRACE_ENV_URL}"
                },
                {
                    "name": "DYNATRACE_API_TOKEN",
                    "value": "${DYNATRACE_API_TOKEN}"
                },
                {
                    "name": "DYNATRACE_CLIENT_ID",
                    "value": "${DYNATRACE_CLIENT_ID}"
                },
                {
                    "name": "DYNATRACE_ACCOUNT_URN",
                    "value": "${DYNATRACE_ACCOUNT_URN}"
                },
                {
                    "name": "DYNATRACE_HOSTGROUP_PREFIX",
                    "value": "${DYNATRACE_HOSTGROUP_PREFIX}"
                },
                {
                    "name": "DYNATRACE_TENANT_CLUSTER_PREFIX",
                    "value": "${DYNATRACE_TENANT_CLUSTER_PREFIX}"
                },
                {
                    "name": "DYNATRACE_TENANT_CLUSTER_SUFFIX",
                    "value": "${DYNATRACE_TENANT_CLUSTER_SUFFIX}"
                }
            ],
            "environmentFiles": [],
            "essential": true,
            "image": "${ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com/${REPO_PREFIX}-backend:latest",
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/ecs-control-center-backend",
                    "awslogs-create-group": "true",
                    "awslogs-region": "${REGION}",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "memoryReservation": 1024,
            "mountPoints": [],
            "name": "backend",
            "portMappings": [
                {
                    "appProtocol": "http",
                    "containerPort": 8000,
                    "hostPort": 0,
                    "name": "backend-8000-tcp",
                    "protocol": "tcp"
                }
            ],
            "systemControls": [],
            "ulimits": [],
            "volumesFrom": []
        }
    ],
    "taskRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/tn-ecs-control-center-role",
    "executionRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/tn-ecs-control-center-role",
    "networkMode": "bridge",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "EC2"
    ],
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "enableFaultInjection": false,
    "tags": [
        {
            "key": "Name",
            "value": "ecs-control-center-backend"
        }
    ]
}
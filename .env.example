# ===========================================
# ECS Control Center - Environment Configuration
# ===========================================
# This file is used by both frontend and backend.
# Copy this file to .env and update with your values (local/dev only).
#
# Everything in this file is optional. The app works with none of it set:
# Dynatrace log queries simply report "not configured", and deployment
# history defaults to table "ecs-control-center-history" in us-east-1.
#
# In production, set these directly as ECS task definition environment
# variables rather than committing a .env file. Never put real values
# (tokens, account IDs, URLs) in this .env.example file or any other
# committed file.

# ===========================================
# Frontend Environment Variables
# ===========================================
# React requires the REACT_APP_ prefix for environment variables.
# Local docker-compose default. On ECS, set this in the task definition
# environment variables to the backend service URL (e.g. https://api.example.com).
# Do NOT rely on localhost — on ECS each container has its own localhost.
REACT_APP_API_BASE=http://localhost:8000

# ===========================================
# Dynatrace Configuration (Backend only, optional)
# ===========================================
# Used for the optional Dynatrace Grail Logs API v2 integration.
DYNATRACE_ENV_URL=https://<env-id>.live.dynatrace.com
DYNATRACE_SSO_URL=https://sso.dynatrace.com/sso/oauth2/token
# Classic tenant (non-Grail): set only DYNATRACE_API_TOKEN (dt0s01.* token).
# Leave DYNATRACE_CLIENT_ID empty — backend uses "Api-Token" header directly.
#
# Grail/OAuth tenant: set BOTH:
#   DYNATRACE_CLIENT_ID  = OAuth client ID  (from DT Account Management → OAuth clients)
#   DYNATRACE_API_TOKEN  = OAuth client secret (dt0c01.* value)
# Backend auto-exchanges them for a short-lived Bearer token (cached, auto-renewed).
DYNATRACE_CLIENT_ID=your-dynatrace-oauth-client-id
DYNATRACE_API_TOKEN=your-dynatrace-oauth-client-secret
# Optional: urn:dtaccount:<account-uuid> — required by some Dynatrace Platform tenants.
DYNATRACE_ACCOUNT_URN=urn:dtaccount:your-account-uuid
# Optional prefix used when matching a Dynatrace host-group by tenant name.
DYNATRACE_HOSTGROUP_PREFIX=
# Optional leading/trailing segment stripped from the ECS cluster name to
# derive the "tenant" used above, e.g. with prefix "myorg" and suffix
# "cluster", cluster "myorg-acme-cluster" -> tenant "acme". Only relevant
# if you use the Hostgroup filter.
DYNATRACE_TENANT_CLUSTER_PREFIX=
DYNATRACE_TENANT_CLUSTER_SUFFIX=

# ===========================================
# Deployment History (DynamoDB)
# ===========================================
# Table is auto-created on backend startup if it doesn't exist.
# The ECS Task Role must have: dynamodb:PutItem, dynamodb:GetItem,
# dynamodb:UpdateItem, dynamodb:Query, and dynamodb:CreateTable.
HISTORY_TABLE_NAME=ecs-control-center-history
HISTORY_AWS_REGION=us-east-1
